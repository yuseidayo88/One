# ─────────────────────────────────────────────────────────────
# AI Company — 環境変数サンプル
# cp .env.example .env.local
# すべて未設定でも Mock Provider + Memory Store でアプリは完全に動作します。
# ─────────────────────────────────────────────────────────────

# ── プロダクト名（1か所で変更可能） ──────────────────────────
NEXT_PUBLIC_APP_NAME="AI Company"
NEXT_PUBLIC_APP_TAGLINE="あなたの会社に、AIの社員を。"
NEXT_PUBLIC_DEFAULT_LOCALE="ja"

# ── セッション署名鍵（本番では必ず 32 文字以上のランダム値） ──
# openssl rand -base64 48
SESSION_SECRET=""

# ── 実行モード ───────────────────────────────────────────────
# memory | supabase   (未設定時は supabase 設定があれば supabase、なければ memory)
DATA_STORE=""
# true にすると LLM/画像/動画/メール等を強制的に Mock にする
FORCE_MOCK_PROVIDERS=""
# 開発デモ組織を自動投入する (memory ストア時のみ)
SEED_DEMO_DATA="true"

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# サーバー専用。絶対にクライアントへ渡さない
SUPABASE_SERVICE_ROLE_KEY=""

# ── LLM ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# モデル名はコードへ散らさず、ここで切り替える
OPENAI_FAST_MODEL="gpt-4o-mini"
ANTHROPIC_REASONING_MODEL="claude-sonnet-4-5"
ANTHROPIC_CODING_MODEL="claude-sonnet-4-5"
# ルーティング上書き (JSON)。例: {"director_chat":"anthropic_reasoning"}
MODEL_ROUTING_CONFIG=""

# ── 課金 (Stripe) ───────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_FOUNDER=""
STRIPE_PRICE_CEO=""

# ── 画像 / 動画 ─────────────────────────────────────────────
# 画像 (Nano Banana 系 = Google 画像生成/編集。動画用途には使わない)
GOOGLE_AI_API_KEY=""
IMAGE_PROVIDER="mock"        # mock | google
# 動画
VIDEO_PROVIDER="mock"        # mock | higgsfield | seedance
HIGGSFIELD_API_KEY=""
SEEDANCE_API_KEY=""

# ── メール ──────────────────────────────────────────────────
EMAIL_PROVIDER="mock"        # mock | resend | gmail | outlook
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""

# ── 検索 ────────────────────────────────────────────────────
SEARCH_PROVIDER="mock"       # mock | brave | tavily
SEARCH_API_KEY=""

# ── デプロイ / ドメイン (Cloudflare) ────────────────────────
DEPLOYMENT_PROVIDER="mock"   # mock | cloudflare
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# ── 管理者 ──────────────────────────────────────────────────
# カンマ区切りのメールアドレス。ここに一致するユーザーだけ /admin へ入れる
ADMIN_EMAILS="founder@example.com"

# ── レート制限 ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
